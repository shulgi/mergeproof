{
  "name": "mergeproof",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Local proof check that reconciles a merged native-text PDF with the CSV that supplied the merge.",
  "keywords": [
    "variable-data printing",
    "data merge",
    "proofing",
    "pdf",
    "csv",
    "prepress"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "mergeproof": "bin/mergeproof.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "sample": "node fixtures/generate.js samples",
    "proof:clean": "node bin/mergeproof.js --csv samples/records.csv --map samples/map.json --pdf samples/proof-clean.pdf",
    "proof:broken": "node bin/mergeproof.js --csv samples/records.csv --map samples/map.json --pdf samples/proof-broken.pdf"
  },
  "dependencies": {
    "csv-parse": "^5.6.0"
  }
}
